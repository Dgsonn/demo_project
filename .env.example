# Postgres connection string for the contact-form leads table.
# Get one free at https://neon.tech (or any Postgres host) then copy this
# file to .env.local and fill in the real value.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Email notification when a new lead comes in — sign up free at
# https://resend.com, create an API key, and verify a sending domain.
# Use onboarding@resend.dev only while testing. Sandbox emails can only be
# delivered to the Resend account email associated with your API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Address that receives the notification (your sales inbox).
CONTACT_NOTIFY_EMAIL=sales@ptthai.vn
# Sender address — must be on a domain verified in Resend or use the sandbox
# sender during testing.
CONTACT_FROM_EMAIL=leads@ptthai.vn

# Admin dashboard (/admin) — views submitted leads and updates their status.
# Mật khẩu được lưu dưới dạng băm scrypt, không lưu chữ thường. Sinh giá trị bằng:
#   npm run admin:hash -- "mật-khẩu-của-bạn"
ADMIN_PASSWORD_HASH=
# Secret used to sign the admin session cookie — generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Website base URL — dùng cho sitemap.xml, robots.txt và thẻ Open Graph.
# Khi deploy, đặt đúng domain thật (vd. https://ptthai.vn).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
